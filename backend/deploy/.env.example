# Copy to .env next to docker-compose.yml and fill in.

# --- Postgres ---
POSTGRES_PASSWORD=change-me-strong

# --- Domain & TLS ---
BASE_DOMAIN=your-domain.com
ACME_EMAIL=ops@your-domain.com
CF_DNS_API_TOKEN=your-cloudflare-dns-token

# --- GitHub App (event source) ---
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...
GITHUB_WEBHOOK_SECRET=shared-secret-with-github

# --- Buddy.works (executor) ---
BUDDY_BASE_URL=https://api.buddy.works
BUDDY_TOKEN=buddy-personal-access-token
BUDDY_WORKSPACE=your-workspace

# --- Integration credential encryption ---
# 32 bytes, hex (64 chars) or base64. Generate with:
#   openssl rand -hex 32
ORCH_SECRET_KEY=replace-with-openssl-rand-hex-32

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:3000
